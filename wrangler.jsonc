{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "us-funding-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "funding-dashboard-db",
      "database_id": "32c13b0f-bb9b-49c5-a5b2-281ebc00fa8e"
    }
  ]
}
